APP_NAME="Philbeilts Industrial Group"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://philbeiltsgroup.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=philbeilts
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Custom SMTP Mail Settings for philbeiltsgroup.com
MAIL_MAILER=smtp
MAIL_HOST=mail.philbeiltsgroup.com
MAIL_PORT=465
MAIL_USERNAME=info@philbeiltsgroup.com
MAIL_PASSWORD=your_cpanel_or_host_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="Philbeiltsindustrialgroup@gmail.com"
MAIL_FROM_NAME="Philbeilts Industrial Group"

VITE_APP_NAME="${APP_NAME}"
